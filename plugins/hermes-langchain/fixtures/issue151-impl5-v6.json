          ],
          "values": [
            "quantity"
          ],
          "expected": "member before-state map"
        },
        {
          "target": "guest CartItem state",
          "source": "in-memory-state",
          "comparison": "unchanged",
          "identity": [
            "CartItem.id"
          ],
          "values": [
            "quantity"
          ],
          "expected": "guest before-state map"
        },
        {
          "target": "guest Cart identity",
          "source": "in-memory-state",
          "comparison": "exact",
          "identity": [],
          "values": [],
          "expected": "guestCartId"
