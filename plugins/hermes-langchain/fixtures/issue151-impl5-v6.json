  "constraints": [
    {
      "id": "CONSTRAINT-AGGREGATE-OWNER",
      "rule": "전체 merge candidate의 collection invariant와 mutation은 Cart aggregate가 소유한다.",
      "source": {
        "locator": "https://github.com/metDaisy/e-commerce-clone-coding/issues/151#Aggregate-behavior와-application-service-책임",
        "claim": "Merge invariant와 state transition은 Cart named behavior로 수행해야 한다."
      }
    },
    {
      "id": "CONSTRAINT-LOCKED-TRANSACTION",
      "rule": "member와 guest Cart를 쓰기 잠금으로 읽고 하나의 local transaction에서 partial state 없이 병합한다.",
      "source": {
        "locator": "docs/requirement/p3/p3-policy.md#불변식",
        "claim": "Cart 변경과 게스트·회원 Cart 병합은 쓰기 잠금과 하나의 로컬 transaction 안에서 전체 결과를 검증하고 부분 결과를 남기지 않는다."
      }
    },
    {
      "id": "CONSTRAINT-LIFECYCLE-PRESERVATION",
      "rule": "30일 guest expiration, 성공 시 guest 삭제, selected payment cleanup 멱등성과 schema 불변 시 migration 미추가를 유지한다.",
      "source": {
        "locator": "https://github.com/metDaisy/e-commerce-clone-coding/issues/151#Persistence와-transaction-보존",
        "claim": "Ownership, merge atomicity, locking, limits와 cleanup idempotency를 보존하고 migration은 실제 schema 변경에만 추가한다."
      }
    },
    {
      "id": "CONSTRAINT-MODULE-PUBLIC-API",
      "rule": "Auth와 Order는 CartMergeApi와 CartPaymentCleanupApi만 사용하고 Cart Repository 또는 Entity에 직접 의존하지 않는다.",
      "source": {
        "locator": "docs/architecture.md#Application-module",
        "claim": "Cross-module callers use only the Cart public application API."
      }
    }
  ],
