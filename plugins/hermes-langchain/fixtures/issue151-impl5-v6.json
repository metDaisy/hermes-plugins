      "expected": [
        "경쟁 merge는 owner lock 해제 전 완료되지 않는다.",
        "lock 해제 후 member의 정확한 CartItem ID→quantity map과 guest 삭제가 하나의 결과로 commit된다."
      ],
      "observables": [
        {
          "target": "concurrent call ordering",
          "source": "concurrency",
          "comparison": "ordered",
          "identity": [],
          "values": [],
